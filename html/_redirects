# Cloudflare Pages redirects - chuyen doi tu html/vercel.json cua ban goc (Vercel).
# Cu phap: <source> <destination> <status>

# wrangler.toml da tat html_handling (giu dung url .html cho SEO - xem ghi chu o do), nen
# Cloudflare KHONG con tu phuc vu index.html cho "/" nua (khac hanh vi mac dinh) - phai tu
# khai bao rewrite nay (status 200 = rewrite giu nguyen URL, KHONG phai redirect doi URL).
/ /index.html 200

/index.html / 301
/trang-nguyen-thoi-xua.html /lich-su-van-hoa/trang-nguyen-thoi-xua.html 301

# "/admin" (khong duoi .html) -> trang trung gian chuyen sang GAS CMS. html/admin/index.html
# la file TINH commit thang, KHONG do build.py sinh ra (noi dung khong doi tru khi GAS deploy
# lai kieu "New deployment" tao URL /exec moi - luc do sua tay file nay). Van phai khai bao
# rewrite du la file nam trong thu muc con, vi wrangler.toml html_handling=none tat tu dong
# resolve thu muc/index.html. CO Y KHONG khai bao Disallow: /admin trong robots.txt - user
# yeu cau khong muon "quang cao" duong dan admin trong 1 file cong khai ai cung doc duoc;
# chi dua vao meta robots noindex tren chinh html/admin/index.html (1 lop, khong phai 2 lop
# nhu static-site-build.md muc 6 khuyen nghi mac dinh - deviation co chu dich, xem README.md).
/admin /admin/index.html 200
/admin/ /admin/index.html 200
